<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated unit tests: no network, no real processes, no system changes. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA2201;CA1861;CA5394;CA1063;CA1816</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bydlo.Core\Bydlo.Core.csproj" />
    <ProjectReference Include="..\..\src\Bydlo.Engines\Bydlo.Engines.csproj" />
    <ProjectReference Include="..\..\src\Bydlo.Helper\Bydlo.Helper.csproj" />
    <ProjectReference Include="..\..\src\Bydlo.Platform\Bydlo.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\tools\Bydlo.BundleEngines\ZapretHostList.cs" Link="Packaging\ZapretHostList.cs" />
    <Compile Include="..\..\src\Bydlo.Desktop\ElevationHandoff.cs" Link="Desktop\ElevationHandoff.cs" />
    <Compile Include="..\..\src\Bydlo.Desktop\WindowsActivationBroker.cs" Link="Desktop\WindowsActivationBroker.cs" />
    <Compile Include="..\..\src\Bydlo.Desktop\UnixActivationBroker.cs" Link="Desktop\UnixActivationBroker.cs" />
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
