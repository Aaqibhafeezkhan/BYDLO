<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders BYDLO pages to PNG with Avalonia.Headless + Skia, always in Mock Mode. No window, no network. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bydlo.App\Bydlo.App.csproj" />
  </ItemGroup>
</Project>
