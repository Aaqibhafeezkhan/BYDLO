<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Bydlo.App.Controls"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:z="using:Bydlo.Engines.Zapret"
             xmlns:l="using:Bydlo.App.Services"
             x:Class="Bydlo.App.Views.ToolsView"
             x:DataType="vm:ToolsViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="880" Margin="24,32,24,32" Spacing="24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="{l:T nav.tools}" />
        <TextBlock Classes="muted" Text="{l:T tools.subtitle}" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Zapret -->
      <Border Classes="panel">
        <StackPanel Spacing="14">
          <Grid x:Name="ZapretHeader" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource Surface2Brush}">
              <c:OutlineIcon Data="{StaticResource LineBolt}" Foreground="{DynamicResource TextMutedBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <TextBlock Classes="h2" Text="Zapret" />
              <TextBlock Classes="faint" Text="{l:T tools.zapret.desc}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="ZapretActions" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Classes="pill" Classes.ok="{Binding ZapretRunning}">
                <TextBlock Text="{Binding ZapretStatus}" />
              </Border>
              <Button Classes="primary" Command="{Binding ToggleZapretCommand}" IsEnabled="{Binding !IsSelecting}">
                <Panel>
                  <TextBlock Text="{l:T tools.start}" Foreground="{DynamicResource OnPrimaryBrush}" IsVisible="{Binding !ZapretRunning}" />
                  <TextBlock Text="{l:T tools.stop}" Foreground="{DynamicResource OnPrimaryBrush}" IsVisible="{Binding ZapretRunning}" />
                </Panel>
              </Button>
            </StackPanel>
          </Grid>

          <Border Classes="banner bad" IsVisible="{Binding ZapretError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ZapretError}" TextWrapping="Wrap" />
          </Border>
          <TextBlock Classes="muted" Text="{Binding ZapretInfo}" TextWrapping="Wrap" />

          <Expander Header="{l:T tools.setup}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsSelecting}">
            <StackPanel Spacing="12">
          <WrapPanel>
            <Button Classes="ghost" Margin="0,0,8,8" Command="{Binding InstallZapretCommand}" IsEnabled="{Binding !IsInstalling}" IsVisible="{Binding CanInstallZapret}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:OutlineIcon Data="{StaticResource LineDownload}" Width="16" Height="16" />
                <TextBlock Text="{l:T tools.zapret.download}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Margin="0,0,8,8" Command="{Binding BrowseZapretCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:OutlineIcon Data="{StaticResource LineFolder}" Width="16" Height="16" />
                <TextBlock Text="{l:T tools.zapret.choose}" />
              </StackPanel>
            </Button>
          </WrapPanel>

          <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
            <TextBlock Classes="caps" Text="{l:T tools.zapret.strategy}" Margin="0,0,0,6" />
            <ComboBox Grid.Row="1" ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="z:ZapretStrategy">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="2" Classes="caps" Text="{l:T tools.zapret.game}" IsVisible="{Binding SupportsGameFilter}" Margin="0,0,0,6" />
            <ComboBox Grid.Column="2" Grid.Row="1" IsVisible="{Binding SupportsGameFilter}" ItemsSource="{x:Static vm:ToolsViewModel.GameFilterModes}" SelectedItem="{Binding GameFilter}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding Converter={x:Static l:PrefixLocConverter.Instance}, ConverterParameter=game.}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock Classes="faint" Text="{l:T tools.zapret.tcpts}" IsVisible="{Binding IsWindows}" TextWrapping="Wrap" />

          <TextBlock Classes="faint" Text="{Binding ZapretPlatformNote}" TextWrapping="Wrap" />

            </StackPanel>
          </Expander>

          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{l:T tools.select.title}" />
            <TextBlock Classes="muted" Text="{l:T tools.select.warning}" TextWrapping="Wrap" />
            <Expander Header="{l:T tools.select.scope}">
              <TextBlock Classes="muted" Text="{l:T tools.select.details}" TextWrapping="Wrap" />
            </Expander>
            <Expander Header="{l:T tools.select.targets}" IsEnabled="{Binding !IsSelecting}">
              <TextBox Text="{Binding TestTargets}" AcceptsReturn="True" MinHeight="80" MaxHeight="180" />
            </Expander>
            <WrapPanel>
              <Button Margin="0,0,8,8" Classes="primary" Content="{l:T tools.select.title}" Command="{Binding SelectZapretCommand}" />
              <Button Margin="0,0,8,8" Classes="ghost" Content="{l:T common.cancel}" Command="{Binding CancelSelectionCommand}" IsVisible="{Binding IsSelecting}" />
              <Button Margin="0,0,8,8" Classes="ghost" Content="{l:T tools.select.apply}" Command="{Binding ApplySelectionCommand}" IsEnabled="{Binding CanApplySelection}" />
            </WrapPanel>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSelecting}" />
            <SelectableTextBlock Text="{Binding SelectionStatus}" TextWrapping="Wrap" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Spacing="6" MinWidth="620">
                <Grid ColumnDefinitions="2*,*,*,*,*,*">
                  <TextBlock Classes="caps" Text="{l:T tools.zapret.strategy}" />
                  <TextBlock Grid.Column="1" Classes="caps" Text="{l:T tools.select.success}" />
                  <TextBlock Grid.Column="2" Classes="caps" Text="{l:T tools.select.errors}" />
                  <TextBlock Grid.Column="3" Classes="caps" Text="{l:T tools.select.timeouts}" TextWrapping="Wrap" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="4" Classes="caps" Text="{l:T tools.select.latency}" />
                  <TextBlock Grid.Column="5" Classes="caps" Text="{l:T tools.select.verdict}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SelectionResults}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ZapretResultRow">
                      <Grid ColumnDefinitions="2*,*,*,*,*,*" Margin="0,4">
                        <TextBlock Text="{Binding Strategy}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Successes}" />
                        <TextBlock Grid.Column="2" Text="{Binding Errors}" />
                        <TextBlock Grid.Column="3" Text="{Binding Timeouts}" />
                        <TextBlock Grid.Column="4" Text="{Binding Latency}" />
                        <TextBlock Grid.Column="5" Text="{Binding Verdict}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
            <Expander Header="{l:T tools.logs}">
              <ScrollViewer MaxHeight="240">
                <SelectableTextBlock Classes="mono" Text="{Binding SelectionLog}" TextWrapping="Wrap" />
              </ScrollViewer>
            </Expander>
          </StackPanel>

          <Expander Header="{l:T tools.zapret.lists}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsSelecting}">
            <StackPanel Spacing="10">
              <ComboBox ItemsSource="{x:Static vm:ToolsViewModel.UserLists}" SelectedItem="{Binding SelectedList}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="z:ZapretUserList">
                    <TextBlock Text="{Binding Converter={x:Static l:PrefixLocConverter.Instance}, ConverterParameter=list.}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Text="{Binding ListText}" AcceptsReturn="True" MinHeight="140" MaxHeight="300"
                       FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" />
              <Button Classes="ghost" HorizontalAlignment="Right" Content="{l:T common.save}" Command="{Binding SaveListCommand}" />
            </StackPanel>
          </Expander>

          <Expander Header="{l:T tools.logs}" HorizontalAlignment="Stretch">
            <Border Classes="tile" MaxHeight="220">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding ZapretLog}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String"><SelectableTextBlock Classes="mono" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Expander>
        </StackPanel>
      </Border>

      <!-- TgWsProxy -->
      <Border Classes="panel">
        <StackPanel Spacing="14">
          <Grid x:Name="TgHeader" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource Surface2Brush}">
              <c:OutlineIcon Data="{StaticResource LineSend}" Foreground="{DynamicResource TextMutedBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <TextBlock Classes="h2" Text="TgWsProxy" />
              <TextBlock Classes="faint" Text="{l:T tools.tg.desc}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="TgActions" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Classes="pill" Classes.ok="{Binding TgRunning}">
                <TextBlock Text="{Binding TgStatus}" />
              </Border>
              <Button Classes="primary" Command="{Binding ToggleTgCommand}">
                <Panel>
                  <TextBlock Text="{l:T tools.start}" Foreground="{DynamicResource OnPrimaryBrush}" IsVisible="{Binding !TgRunning}" />
                  <TextBlock Text="{l:T tools.stop}" Foreground="{DynamicResource OnPrimaryBrush}" IsVisible="{Binding TgRunning}" />
                </Panel>
              </Button>
            </StackPanel>
          </Grid>

          <Border Classes="banner bad" IsVisible="{Binding TgError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding TgError}" TextWrapping="Wrap" />
          </Border>

          <Border Classes="tile">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mono" Text="{Binding TgLink}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button Classes="icon" ToolTip.Tip="{l:T tools.tg.copy}" Command="{Binding CopyTgLinkToClipboardCommand}">
                  <c:OutlineIcon Data="{StaticResource LineCopy}" Width="16" Height="16" />
                </Button>
                <Button Classes="icon" ToolTip.Tip="{l:T tools.tg.open}" Command="{Binding OpenInTelegramCommand}">
                  <c:OutlineIcon Data="{StaticResource LineSend}" Width="16" Height="16" />
                </Button>
                <Button Classes="icon" ToolTip.Tip="{l:T tools.tg.regen}" Command="{Binding RegenerateSecretCommand}">
                  <c:OutlineIcon Data="{StaticResource LineRefresh}" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Expander Header="{l:T common.advanced}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="12">
          <Grid ColumnDefinitions="2*,12,*" RowDefinitions="Auto,Auto">
            <TextBlock Classes="caps" Text="{l:T tools.tg.host}" Margin="0,0,0,6" />
            <TextBox Grid.Row="1" Text="{Binding TgHost}" />
            <TextBlock Grid.Column="2" Classes="caps" Text="{l:T tools.tg.port}" Margin="0,0,0,6" />
            <NumericUpDown Grid.Column="2" Grid.Row="1" Value="{Binding TgPort}" Minimum="1" Maximum="65535" FormatString="0" />
          </Grid>

          <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="{Binding TgRuntimeInfo}" TextWrapping="Wrap" />
          </StackPanel>


              <StackPanel Spacing="6">
                <TextBlock Classes="caps" Text="{l:T tools.tg.dcip}" />
                <TextBox Text="{Binding TgDcIps}" AcceptsReturn="True" MinHeight="60" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" />
                <TextBlock Classes="faint" Text="{l:T tools.tg.dcip.hint}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Classes="caps" Text="{l:T tools.tg.faketls}" />
                <TextBox Text="{Binding TgFakeTls}" Watermark="example.com" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:T tools.tg.cf}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding TgCfFallback}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:T tools.tg.verbose}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding TgVerbose}" />
              </Grid>
              <StackPanel Spacing="6" IsVisible="{Binding TgCfFallback}">
                <TextBlock Classes="caps" Text="{l:T tools.tg.cfdomains}" />
                <TextBox Text="{Binding TgCfDomains}" AcceptsReturn="True" MinHeight="44" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" />
                <TextBlock Classes="faint" Text="{l:T tools.tg.cfdomains.hint}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Classes="ghost" HorizontalAlignment="Right" Content="{l:T common.save}" Command="{Binding SaveTgCommand}" />
            </StackPanel>
          </Expander>

          <Expander Header="{l:T tools.logs}" HorizontalAlignment="Stretch">
            <Border Classes="tile" MaxHeight="220">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding TgLog}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String"><SelectableTextBlock Classes="mono" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Expander>
        </StackPanel>
      </Border>

      <!-- Engines -->
      <Expander Header="{l:T tools.engines}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12">
          <TextBlock Classes="faint" Text="{l:T tools.engines.hint}" TextWrapping="Wrap" />
          <Border Classes="tile" IsVisible="{Binding IsWindows}">
            <StackPanel Spacing="8">
              <TextBlock Text="{l:T tools.openvpn.driver.title}" FontWeight="Medium" />
              <TextBlock Classes="muted" Text="{l:T tools.openvpn.driver.hint}" TextWrapping="Wrap" />
              <CheckBox IsChecked="{Binding OpenVpnDriverConsent}">
                <TextBlock Text="{l:T tools.openvpn.driver.consent}" TextWrapping="Wrap" />
              </CheckBox>
              <Button Classes="ghost" Content="{l:T tools.openvpn.driver.install}" Command="{Binding InstallOpenVpnDriverCommand}" IsEnabled="{Binding OpenVpnDriverConsent}" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Engines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EngineRow">
                <Border Classes="tile" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                        <TextBlock Classes="faint" Text="{Binding Version}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Classes="faint" Text="{Binding License}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Border Classes="pill" Classes.ok="{Binding IsReady}">
                        <TextBlock Text="{Binding Status}" />
                      </Border>
                      <Button Classes="ghost" Padding="10,6" IsVisible="{Binding CanInstall}"
                              Command="{Binding $parent[UserControl].((vm:ToolsViewModel)DataContext).InstallEngineCommand}" CommandParameter="{Binding}">
                        <c:OutlineIcon Data="{StaticResource LineDownload}" Width="15" Height="15" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
