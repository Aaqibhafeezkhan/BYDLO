<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:l="using:Bydlo.App.Services"
             x:Class="Bydlo.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="980" Margin="24,28,24,28" Spacing="18" HorizontalAlignment="Stretch">
      <StackPanel Spacing="5">
        <TextBlock Classes="caps" Text="{l:T home.overline}" />
        <TextBlock Classes="h1" Text="{l:T home.title}" />
      </StackPanel>
      <Grid x:Name="Dashboard" ColumnDefinitions="1.1*,*" RowDefinitions="Auto,Auto">
        <Border Classes="card" Padding="16,20" Background="{DynamicResource SurfaceBrush}">
          <Grid>
            <Border Background="{DynamicResource GlassSheenBrush}" CornerRadius="24" Margin="-15,-19" IsHitTestVisible="False" />
            <StackPanel Spacing="2">

              <!-- Status -->
              <StackPanel HorizontalAlignment="Center" Spacing="6">
                <Border HorizontalAlignment="Center" Classes="pill"
                        Classes.ok="{Binding IsConnected}" Classes.bad="{Binding IsError}" Classes.warn="{Binding IsBusy}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Classes="dot" Width="7" Height="7" />
                    <TextBlock Text="{Binding StatusText}" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Connect hero -->
              <Grid Width="264" Height="246" HorizontalAlignment="Center">
                <Ellipse Width="264" Height="246" Fill="{DynamicResource GlowBrush}" Opacity="{Binding !IsConnected, Converter={x:Static l:BoolToOpacityConverter.Instance}}">
                  <Ellipse.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.5" /></Transitions></Ellipse.Transitions>
                </Ellipse>
                <Ellipse Width="264" Height="246" Fill="{DynamicResource GlowOnBrush}" Opacity="{Binding IsConnected, Converter={x:Static l:BoolToOpacityConverter.Instance}}">
                  <Ellipse.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.5" /></Transitions></Ellipse.Transitions>
                </Ellipse>
                <Ellipse Width="226" Height="226" Stroke="{DynamicResource LineBrush}" StrokeThickness="1" />
                <Ellipse Width="210" Height="210" Stroke="{DynamicResource GlassEdgeBrush}" StrokeThickness="1" />
                <Ellipse Classes="ring" Classes.active="{Binding IsBusy}" Width="196" Height="196"
                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" RenderTransformOrigin="50%,50%">
                  <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                </Ellipse>

                <Border Width="190" Height="190" CornerRadius="95" BoxShadow="{DynamicResource ConnectShadow}" IsHitTestVisible="False" />
                <Button Classes="connect" Command="{Binding ToggleConnectionCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding ButtonText}">
                  <Grid Width="188" Height="188">
                    <Ellipse Fill="{DynamicResource ConnectIdleBrush}" />
                    <Ellipse Fill="{DynamicResource ConnectOnBrush}" Opacity="{Binding IsConnected, Converter={x:Static l:BoolToOpacityConverter.Instance}}">
                      <Ellipse.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.35" /></Transitions></Ellipse.Transitions>
                    </Ellipse>
                    <Ellipse Fill="{DynamicResource GlassSheenBrush}" Stroke="{DynamicResource GlassEdgeBrush}" StrokeThickness="1.5" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                      <PathIcon Data="{StaticResource IconPower}" Width="52" Height="52" HorizontalAlignment="Center"
                                Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding !IsConnected}" />
                      <PathIcon Data="{StaticResource IconPower}" Width="52" Height="52" HorizontalAlignment="Center"
                                Foreground="White" IsVisible="{Binding IsConnected}" />
                      <TextBlock Text="{Binding ButtonText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>
                  </Grid>
                </Button>
              </Grid>

              <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding Elapsed}" FontSize="32" FontWeight="Light" HorizontalAlignment="Center" FontFeatures="tnum" />
                <TextBlock Classes="muted" Text="{Binding Hint}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Margin="8,0" />
              </StackPanel>

              <!-- Explicit connection check: only when connected, never automatic. -->
              <StackPanel IsVisible="{Binding IsConnected}" Spacing="10" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                <Button Classes="ghost" HorizontalAlignment="Center" Command="{Binding CheckConnectionCommand}" IsEnabled="{Binding CanRunCheck}"
                        AutomationProperties.Name="{Binding CheckButtonText}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconCheck}" Width="15" Height="15" />
                    <TextBlock Text="{Binding CheckButtonText}" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="faint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding CheckDisabledReason}" IsVisible="{Binding CheckDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Border Classes="tile" IsVisible="{Binding HasCheckResult}" HorizontalAlignment="Stretch" MaxWidth="460">
                  <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                    <TextBlock Classes="caps" Text="{l:T home.check.ip}" />
                    <TextBlock Classes="caps" Grid.Column="1" Text="{l:T home.check.country}" />
                    <TextBlock Classes="caps" Grid.Column="2" Text="{l:T home.check.latency}" />
                    <SelectableTextBlock Grid.Row="1" Text="{Binding CheckIp}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CheckCountry}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CheckLatency}" FontWeight="SemiBold" />
                  </Grid>
                </Border>
                <Border Classes="banner bad" IsVisible="{Binding HasCheckError}">
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Data="{StaticResource IconAlert}" Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding CheckError}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </StackPanel>

              <Border Classes="banner bad" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,10,0,0">
                <Grid ColumnDefinitions="Auto,*">
                  <PathIcon Data="{StaticResource IconAlert}" Foreground="{DynamicResource DangerBrush}" />
                  <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Error}" TextWrapping="Wrap" />
                </Grid>
              </Border>

            </StackPanel>
          </Grid>
        </Border>

        <!-- Server + mode -->
        <Border x:Name="ServerCard" Classes="card" Grid.Column="1" Margin="18,0,0,0" Padding="22">
          <StackPanel Spacing="22" VerticalAlignment="Center">
            <Border Width="54" Height="54" CornerRadius="19" HorizontalAlignment="Left" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1">
              <PathIcon Data="{StaticResource IconServers}" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="{l:T home.server}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="icon" Command="{Binding Shell.NavigateCommand}" CommandParameter="connections"
                      ToolTip.Tip="{l:T home.manage}">
                <PathIcon Data="{StaticResource IconPlus}" Width="16" Height="16" />
              </Button>
            </Grid>
            <ComboBox ItemsSource="{Binding Shell.Profiles}" SelectedItem="{Binding Shell.SelectedProfile}"
                      HorizontalAlignment="Stretch" PlaceholderText="{l:T home.noprofiles}" IsEnabled="{Binding !IsBusy}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileItem">
                  <StackPanel Spacing="2" Margin="0,2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="faint" Text="{Binding Details}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Height="1" Background="{DynamicResource LineBrush}" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{l:T home.tun}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Classes="faint" Text="{l:T home.tun.hint}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsTun}" IsEnabled="{Binding !IsBusy}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Quick cards -->
      <Grid x:Name="QuickCards" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">
        <Border x:Name="TrafficCard" Classes="card" MinHeight="136" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Classes="caps" Text="{l:T home.speed}" />
            <Grid ColumnDefinitions="*,*">
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconDown}" Width="13" Height="13" Foreground="{DynamicResource SuccessBrush}" />
                  <TextBlock Classes="faint" Text="{l:T stats.down}" />
                </StackPanel>
                <TextBlock Text="{Binding DownSpeed}" FontSize="17" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconUp}" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Classes="faint" Text="{l:T stats.up}" />
                </StackPanel>
                <TextBlock Text="{Binding UpSpeed}" FontSize="17" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="faint" Text="{l:T stats.engine}" />
              <TextBlock Classes="faint" Text="{Binding EngineLabel}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border x:Name="ZapretCard" Classes="card" Grid.Column="1" MinHeight="136" Padding="16">
          <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*,Auto">
            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
              <PathIcon Data="{StaticResource IconBolt}" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
              <TextBlock Text="Zapret" FontWeight="SemiBold" />
              <TextBlock Classes="faint" Text="{Binding ZapretState}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" IsChecked="{Binding ZapretOn, Mode=OneWay}" Command="{Binding ToggleZapretCommand}" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Classes="faint" Margin="0,10,0,0" Text="{l:T home.zapret.hint}" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border x:Name="TelegramCard" Classes="card" Grid.Column="2" MinHeight="136" Padding="16">
          <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*,Auto">
            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
              <PathIcon Data="{StaticResource IconSend}" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
              <TextBlock Text="TgWsProxy" FontWeight="SemiBold" />
              <TextBlock Classes="faint" Text="{Binding TgState}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" IsChecked="{Binding TgOn, Mode=OneWay}" Command="{Binding ToggleTgCommand}" />
            <Button Grid.Row="2" Grid.ColumnSpan="3" Classes="ghost" Margin="0,10,0,0" HorizontalAlignment="Stretch" Command="{Binding CopyTgLinkCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource IconLink}" Width="15" Height="15" />
                <TextBlock Text="{l:T tools.tg.copy}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
