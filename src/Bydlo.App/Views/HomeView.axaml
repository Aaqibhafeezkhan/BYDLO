<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:l="using:Bydlo.App.Services"
             xmlns:c="using:Bydlo.App.Controls"
             x:Class="Bydlo.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel x:Name="Page" MaxWidth="620" Margin="24,32,24,28">
      <TextBlock Classes="page-label" Text="{l:T home.connection}" />
      <StackPanel IsVisible="{Binding IsEmpty}" Spacing="20" Margin="0,48,0,0">
        <c:OutlineIcon Data="{StaticResource LineServers}" Width="40" Height="40" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="{l:T home.empty.title}" FontSize="30" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{l:T home.empty.text}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
        <Button Classes="primary" Content="{l:T wizard.title}" Command="{Binding Shell.OpenAddServerCommand}" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel IsVisible="{Binding !IsEmpty}" x:Name="Hero" Margin="0,28,0,0" HorizontalAlignment="Stretch">
        <Border Classes="connection-mark" Classes.connected="{Binding IsConnected}" Classes.busy="{Binding IsBusy}" Classes.error="{Binding IsError}"
                Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,18">
          <c:OutlineIcon Data="{StaticResource LineShield}" Width="26" Height="26" />
        </Border>
        <TextBlock x:Name="StatusTitle" Text="{Binding StatusText}" FontSize="38" FontWeight="Medium" LetterSpacing="-1"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding Hint}" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="460" Margin="0,10,0,26" FontSize="13" />
        <ComboBox Classes="server-picker" ItemsSource="{Binding Shell.Profiles}" SelectedItem="{Binding Shell.SelectedProfile}"
                  HorizontalAlignment="Stretch" MaxWidth="400" PlaceholderText="{l:T home.noprofiles}"
                  IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{l:T home.server}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileItem">
              <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                <c:OutlineIcon Data="{StaticResource LineServers}" Width="22" Height="22" Margin="0,0,14,0" Foreground="{DynamicResource TextMutedBrush}" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="faint" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="text-action" Content="{l:T import.title}" Command="{Binding Shell.NavigateCommand}" CommandParameter="connections"
                HorizontalAlignment="Center" Margin="0,10,0,0" IsVisible="{Binding !HasProfiles}" />
        <Border Classes="pill ok" IsVisible="{Binding IsChainActive}" HorizontalAlignment="Center" Margin="0,10,0,0" Padding="10,4">
          <TextBlock Text="{Binding ActiveChainName}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>
        <Button Classes="text-action" Content="{l:T home.best}" Command="{Binding BestServerCommand}"
                HorizontalAlignment="Center" Margin="0,10,0,0" IsVisible="{Binding HasProfiles}" />
        <Border Width="224" Height="54" HorizontalAlignment="Center" Margin="0,22,0,20" CornerRadius="12" BoxShadow="{DynamicResource ActionShadow}">
          <Button Classes="primary connect-action" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding ToggleConnectionCommand}" AutomationProperties.Name="{Binding ButtonText}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:OutlineIcon Data="{StaticResource LinePower}" Width="20" Height="20" Foreground="{DynamicResource OnPrimaryBrush}" />
              <TextBlock Text="{Binding ButtonText}" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="Medium" FontSize="15" />
            </StackPanel>
          </Button>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Border Classes="mode-switch">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="segment mode" GroupName="connectionMode" IsChecked="{Binding IsProxy}" IsEnabled="{Binding !IsBusy}">
                <TextBlock Text="{l:T home.mode.proxy}" />
              </RadioButton>
              <RadioButton Classes="segment mode" GroupName="connectionMode" IsChecked="{Binding IsWholeDevice}" IsEnabled="{Binding !IsBusy}">
                <TextBlock Text="{l:T home.mode.device}" />
              </RadioButton>
            </StackPanel>
          </Border>
          <Button Classes="icon" ToolTip.Tip="{Binding ModeHint}" AutomationProperties.Name="{l:T home.mode}" Command="{Binding ToggleModeHintCommand}">
            <c:OutlineIcon Data="{StaticResource LineInfo}" Width="16" Height="16" />
          </Button>
        </StackPanel>
        <ComboBox ItemsSource="{Binding RoutingPresetOptions}" SelectedIndex="{Binding RoutingPresetIndex}"
                  HorizontalAlignment="Center" IsEnabled="{Binding !IsBusy}"
                  AutomationProperties.Name="{l:T routing.preset.label}" />
        <TextBlock Classes="faint" Text="{Binding ModeHint}" IsVisible="{Binding ShowModeHint}" TextAlignment="Center" TextWrapping="Wrap" Margin="12,12,12,0" />
        <Border Classes="banner bad" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,20,0,0">
          <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
      <Border IsVisible="{Binding !IsEmpty}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0">
        <Grid ColumnDefinitions="*,*,*">
          <StackPanel Spacing="7" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:OutlineIcon Data="{StaticResource LineDown}" Width="13" Height="13" />
              <TextBlock Classes="faint" Text="{l:T stats.down}" />
            </StackPanel>
            <TextBlock Classes="metric" Text="{Binding DownSpeed}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="7" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:OutlineIcon Data="{StaticResource LineUp}" Width="13" Height="13" />
              <TextBlock Classes="faint" Text="{l:T stats.up}" />
            </StackPanel>
            <TextBlock Classes="metric" Text="{Binding UpSpeed}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="7" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:OutlineIcon Data="{StaticResource LineClock}" Width="13" Height="13" />
              <TextBlock Classes="faint" Text="{l:T home.duration}" />
            </StackPanel>
            <TextBlock Classes="metric" Text="{Binding Elapsed}" />
          </StackPanel>
        </Grid>
      </Border>
      <Expander Header="{l:T home.check}" IsVisible="{Binding IsConnected}" HorizontalAlignment="Stretch" Margin="0,4,0,0">
        <StackPanel Spacing="12">
          <Button Classes="ghost" Content="{Binding CheckButtonText}" Command="{Binding CheckConnectionCommand}" IsEnabled="{Binding CanRunCheck}" HorizontalAlignment="Left" />
          <TextBlock Classes="faint" Text="{Binding CheckDisabledReason}" IsVisible="{Binding CheckDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
          <StackPanel Spacing="8" IsVisible="{Binding HasCheckResult}">
            <TextBlock Classes="caps" Text="{l:T home.check.ip}" />
            <TextBlock Text="{Binding CheckIp}" FontWeight="Medium" />
            <TextBlock Classes="caps" Text="{l:T home.check.country}" />
            <TextBlock Text="{Binding CheckCountry}" TextWrapping="Wrap" />
            <TextBlock Classes="caps" Text="{l:T home.check.latency}" />
            <TextBlock Text="{Binding CheckLatency}" />
          </StackPanel>
          <Border Classes="banner bad" IsVisible="{Binding HasCheckError}"><TextBlock Text="{Binding CheckError}" TextWrapping="Wrap" /></Border>
        </StackPanel>
      </Expander>
      <Grid IsVisible="{Binding !IsEmpty}" ColumnDefinitions="*,Auto" Margin="0,16,0,8">
        <TextBlock Classes="page-label" Text="{l:T nav.tools}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="text-action" Content="{l:T home.tools.manage}" Command="{Binding Shell.NavigateCommand}" CommandParameter="tools" />
      </Grid>
      <Border IsVisible="{Binding !IsEmpty}" Classes="panel" Padding="16,0">
        <StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,14">
            <c:OutlineIcon Data="{StaticResource LineBolt}" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,12,0">
              <TextBlock Text="Zapret" FontWeight="Medium" FontSize="13" />
              <TextBlock Classes="faint" Text="{Binding ZapretState}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" IsChecked="{Binding ZapretOn, Mode=OneWay}" Command="{Binding ToggleZapretCommand}" AutomationProperties.Name="Zapret" />
          </Grid>
          <Border Height="1" Background="{DynamicResource LineBrush}" />
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14">
            <c:OutlineIcon Data="{StaticResource LineSend}" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,12,0">
              <TextBlock Text="TgWsProxy" FontWeight="Medium" FontSize="13" />
              <TextBlock Classes="faint" Text="{Binding TgState}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon" Command="{Binding CopyTgLinkCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="{l:T tools.tg.copy}" ToolTip.Tip="{l:T tools.tg.copy}">
              <c:OutlineIcon Data="{StaticResource LineCopy}" Width="16" Height="16" />
            </Button>
            <ToggleSwitch Grid.Column="3" IsChecked="{Binding TgOn, Mode=OneWay}" Command="{Binding ToggleTgCommand}" AutomationProperties.Name="TgWsProxy" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
