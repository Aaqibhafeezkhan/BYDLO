<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:e="using:Bydlo.Core.Engines"
             xmlns:l="using:Bydlo.App.Services"
             x:Class="Bydlo.App.Views.ActiveConnectionsView"
             x:DataType="vm:ActiveConnectionsViewModel">
  <Expander x:Name="ActiveConnectionsList" Header="{l:T stats.connections.title}" IsExpanded="{Binding ActiveConnectionsExpanded}" HorizontalAlignment="Stretch">
    <StackPanel Spacing="8">
      <TextBlock IsVisible="{Binding !SupportsActiveConnections}" Text="{l:T stats.connections.unavailable}" TextWrapping="Wrap" />
      <TextBlock IsVisible="{Binding ConnectionListError}" Text="{l:T stats.connections.error}" TextWrapping="Wrap" />
      <TextBox IsVisible="{Binding SupportsActiveConnections}" Text="{Binding ConnectionFilter}"
               Watermark="{l:T stats.connections.filter}" AutomationProperties.Name="{l:T stats.connections.filter}" />
      <TextBlock Text="{l:T stats.connections.empty}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding FilteredConnections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="e:ActiveConnection">
            <Border Classes="tile" Padding="12" Margin="0,2">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Host}" FontWeight="Medium" TextWrapping="Wrap" />
                <StackPanel Spacing="2">
                  <TextBlock Classes="faint" Text="{l:T stats.connections.process}" />
                  <TextBlock Text="{Binding Process}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="faint" Text="{l:T stats.connections.rule}" />
                  <TextBlock Text="{Binding Rule}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="faint" Text="{l:T stats.connections.outbound}" />
                  <TextBlock Text="{Binding Outbound}" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel>
                  <TextBlock Text="{l:T stats.down}" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding DownloadBytes, Converter={x:Static l:ByteCountConverter.Instance}}" Margin="0,0,12,0" />
                  <TextBlock Text="{l:T stats.up}" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding UploadBytes, Converter={x:Static l:ByteCountConverter.Instance}}" />
                </WrapPanel>
                <WrapPanel>
                  <Button Classes="danger" Content="{l:T stats.connections.close}" Margin="0,0,8,0"
                          Command="{Binding $parent[UserControl].((vm:ActiveConnectionsViewModel)DataContext).CloseConnectionCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="{l:T routing.rules.add}"
                          Command="{Binding $parent[UserControl].((vm:ActiveConnectionsViewModel)DataContext).AddConnectionRuleCommand}"
                          CommandParameter="{Binding}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Expander>
</UserControl>
