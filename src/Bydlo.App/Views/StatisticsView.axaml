<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:c="using:Bydlo.App.Controls"
             xmlns:l="using:Bydlo.App.Services"
             x:Class="Bydlo.App.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">
  <ScrollViewer>
    <Border Classes="workspace">
      <StackPanel Classes="page">
        <Border Classes="page-heading">
          <StackPanel Spacing="8">
            <TextBlock Classes="h1" Text="{l:T nav.statistics}" />
            <TextBlock Classes="muted" Text="{l:T stats.subtitle}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="12">
            <UniformGrid Columns="3" IsVisible="{Binding HasTraffic}">
              <Border Classes="readout" Margin="0,0,8,0">
                <StackPanel Spacing="4">
                  <TextBlock Classes="caps" TextTrimming="CharacterEllipsis" Text="{l:T stats.down}" />
                  <TextBlock Text="{Binding Down}" Classes="metric" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SuccessBrush}" />
                  <TextBlock Classes="faint" Text="{Binding TotalDown}" />
                </StackPanel>
              </Border>
              <Border Classes="readout" Margin="0,0,8,0">
                <StackPanel Spacing="4">
                  <TextBlock Classes="caps" TextTrimming="CharacterEllipsis" Text="{l:T stats.up}" />
                  <TextBlock Text="{Binding Up}" Classes="metric" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Classes="faint" Text="{Binding TotalUp}" />
                </StackPanel>
              </Border>
              <Border Classes="readout" Margin="0,0,8,0">
                <StackPanel Spacing="4">
                  <TextBlock Classes="caps" TextTrimming="CharacterEllipsis" Text="{l:T stats.engine}" />
                  <TextBlock Text="{Binding Engine}" Classes="metric" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="faint" Text="{Binding Server}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </UniformGrid>
            <Border Classes="section" IsVisible="{Binding HasTraffic}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h3" Text="{l:T stats.chart}" />
                <Grid ColumnDefinitions="*,16,*">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="faint" Text="{l:T stats.down}" />
                    <c:Sparkline Height="54" Values="{Binding Shell.DownHistory}" Stroke="{DynamicResource SuccessBrush}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Classes="faint" Text="{l:T stats.up}" />
                    <c:Sparkline Height="54" Values="{Binding Shell.UpHistory}" Stroke="{DynamicResource AccentBrush}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding !HasTraffic}" Spacing="5">
              <TextBlock Classes="h2" Text="{l:T stats.chart}" />
              <TextBlock Classes="muted" Text="{l:T stats.waiting}" IsVisible="{Binding !NoStatsEngine}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{l:T stats.nostats}" IsVisible="{Binding NoStatsEngine}" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{Binding Engine}" IsVisible="{Binding NoStatsEngine}" />
              <TextBlock Classes="faint" Text="{Binding Server}" IsVisible="{Binding NoStatsEngine}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="section">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{l:T stats.log}" />
            <TextBlock Classes="faint" Text="{l:T stats.log.hint}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{l:T stats.log.copy}" Command="{Binding CopyLogCommand}" />
              <Button Classes="ghost" Content="{l:T stats.log.clear}" Command="{Binding ClearLogCommand}" />
            </StackPanel>
            <Border Classes="tile" Height="300">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Log}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String"><SelectableTextBlock Classes="mono" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
