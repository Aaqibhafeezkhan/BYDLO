<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:e="using:Bydlo.Core.Engines"
             xmlns:c="using:Bydlo.App.Controls"
             xmlns:l="using:Bydlo.App.Services"
             x:Class="Bydlo.App.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="880" Margin="24,32,24,32" Spacing="24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="{l:T nav.statistics}" />
        <TextBlock Classes="muted" Text="{l:T stats.subtitle}" TextWrapping="Wrap" />
      </StackPanel>

      <WrapPanel>
        <Border Width="220" Margin="0,0,12,12" Padding="0,12,0,4">
          <StackPanel Spacing="4">
            <TextBlock Classes="caps" Text="{l:T stats.down}" />
            <TextBlock Text="{Binding Down}" FontSize="28" FontWeight="Medium" Foreground="{DynamicResource SuccessBrush}" />
            <TextBlock Classes="faint" Text="{Binding TotalDown}" />
          </StackPanel>
        </Border>
        <Border Width="220" Margin="0,0,12,12" Padding="0,12,0,4">
          <StackPanel Spacing="4">
            <TextBlock Classes="caps" Text="{l:T stats.up}" />
            <TextBlock Text="{Binding Up}" FontSize="28" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Classes="faint" Text="{Binding TotalUp}" />
          </StackPanel>
        </Border>
        <Border Width="220" Margin="0,0,12,12" Padding="0,12,0,4">
          <StackPanel Spacing="4">
            <TextBlock Classes="caps" Text="{l:T stats.engine}" />
            <TextBlock Text="{Binding Engine}" FontSize="28" FontWeight="Medium" />
            <TextBlock Classes="faint" Text="{Binding Server}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <Border Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Classes="h3" Text="{l:T stats.chart}" />
          <TextBlock Classes="faint" Text="{l:T stats.nostats}" IsVisible="{Binding NoStatsEngine}" TextWrapping="Wrap" />
          <TextBlock Classes="caps" Text="{l:T stats.down}" />
          <c:Sparkline Height="90" Values="{Binding Shell.DownHistory}" Stroke="{DynamicResource SuccessBrush}" />
          <TextBlock Classes="caps" Text="{l:T stats.up}" />
          <c:Sparkline Height="60" Values="{Binding Shell.UpHistory}" Stroke="{DynamicResource AccentBrush}" />
        </StackPanel>
      </Border>

      <Expander Header="{l:T stats.connections.title}" IsExpanded="{Binding ActiveConnectionsExpanded}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">
          <TextBlock IsVisible="{Binding !SupportsActiveConnections}" Text="{l:T stats.connections.unavailable}" TextWrapping="Wrap" />
          <TextBlock IsVisible="{Binding ConnectionListError}" Text="{l:T stats.connections.error}" TextWrapping="Wrap" />
          <TextBox IsVisible="{Binding SupportsActiveConnections}" Text="{Binding ConnectionFilter}"
                   Watermark="{l:T stats.connections.filter}" />
          <ItemsControl ItemsSource="{Binding FilteredConnections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="e:ActiveConnection">
                <Border Classes="tile" Padding="8" Margin="0,2">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Host}" FontWeight="Medium" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Process}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Rule}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Outbound}" TextWrapping="Wrap" />
                    <WrapPanel>
                      <TextBlock Text="{l:T stats.down}" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding DownloadBytes}" Margin="0,0,12,0" />
                      <TextBlock Text="{l:T stats.up}" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding UploadBytes}" />
                    </WrapPanel>
                    <WrapPanel>
                      <Button Content="{l:T stats.connections.close}" Margin="0,0,8,0"
                              Command="{Binding $parent[UserControl].((vm:StatisticsViewModel)DataContext).CloseConnectionCommand}"
                              CommandParameter="{Binding}" />
                      <Button Content="{l:T routing.rules.add}"
                              Command="{Binding $parent[UserControl].((vm:StatisticsViewModel)DataContext).AddConnectionRuleCommand}"
                              CommandParameter="{Binding}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>

      <Border Classes="section">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h3" Text="{l:T stats.log}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button Classes="icon" ToolTip.Tip="{l:T stats.log.copy}" Command="{Binding CopyLogCommand}">
                <c:OutlineIcon Data="{StaticResource LineCopy}" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{l:T stats.log.clear}" Command="{Binding ClearLogCommand}">
                <c:OutlineIcon Data="{StaticResource LineDelete}" Width="16" Height="16" />
              </Button>
            </StackPanel>
          </Grid>
          <TextBlock Classes="faint" Text="{l:T stats.log.hint}" TextWrapping="Wrap" />
          <Border Classes="tile" Height="300">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Log}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String"><SelectableTextBlock Classes="mono" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
