<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:v="using:Bydlo.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Bydlo.App.Controls"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:m="using:Bydlo.Core.Models"
             xmlns:l="using:Bydlo.App.Services"
             x:Class="Bydlo.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="WrapPanel#CategoryButtons Button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="WrapPanel#CategoryButtons Button.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
  </UserControl.Styles>
  <Border Classes="workspace" VerticalAlignment="Stretch">
    <Grid RowDefinitions="Auto,*" Margin="20,22,20,0">
      <Border Classes="page-heading settings-heading" Margin="0,0,0,12">
        <TextBlock Classes="h1" Text="{l:T nav.settings}" />
      </Border>
      <Grid x:Name="SettingsLayout" Grid.Row="1" RowDefinitions="Auto,*" ColumnDefinitions="*,0">
        <Border x:Name="CategoryIndex" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,12">
          <StackPanel Spacing="4">
            <ScrollViewer x:Name="CategoryScroll" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <WrapPanel x:Name="CategoryButtons" Orientation="Vertical" ItemWidth="169">
              <Button Classes="quiet" Content="{l:T settings.appearance}" Tag="AppearanceSection" Click="ScrollToSection" />
              <Button Classes="quiet" Content="{l:T settings.section.import}" Tag="ImportSection" Click="ScrollToSection" />
              <Button Classes="quiet" Content="{l:T settings.desktop}" Tag="DesktopSection" Click="ScrollToSection" />
              <Button Classes="quiet" Content="{l:T settings.connection}" Tag="ConnectionSection" Click="ScrollToSection" />
              <Button Classes="quiet" Content="{l:T settings.section.advanced}" Tag="AdvancedSection" Click="ScrollToSection" />
              <Button Classes="quiet" Content="{l:T settings.section.backup}" Tag="BackupSettings" Click="ScrollToSection" />
              <Button Classes="quiet" Content="{l:T settings.section.about}" Tag="AboutSection" Click="ScrollToSection" />
              </WrapPanel>
            </ScrollViewer>
            <ComboBox x:Name="CompactCategory" HorizontalAlignment="Stretch" PlaceholderText="{l:T settings.section.jump}"
                      AutomationProperties.Name="{l:T settings.section.jump}" SelectedIndex="0" SelectionChanged="OnCategorySelected">
              <ComboBoxItem Tag="AppearanceSection" Content="{l:T settings.appearance}" />
              <ComboBoxItem Tag="ImportSection" Content="{l:T settings.section.import}" />
              <ComboBoxItem Tag="DesktopSection" Content="{l:T settings.desktop}" />
              <ComboBoxItem Tag="ConnectionSection" Content="{l:T settings.connection}" />
              <ComboBoxItem Tag="AdvancedSection" Content="{l:T settings.section.advanced}" />
              <ComboBoxItem Tag="BackupSettings" Content="{l:T settings.section.backup}" />
              <ComboBoxItem Tag="AboutSection" Content="{l:T settings.section.about}" />
            </ComboBox>
            <WrapPanel IsVisible="{Binding Shell.IsCompact}">
              <Button Classes="quiet" Content="{l:T nav.routing}" Command="{Binding Shell.NavigateCommand}" CommandParameter="routing" />
              <Button Classes="quiet" Content="{l:T nav.statistics}" Command="{Binding Shell.NavigateCommand}" CommandParameter="statistics" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Grid x:Name="SettingsContent" Grid.Row="1" RowDefinitions="Auto,*">
          <Border Classes="page-heading" Margin="0,0,0,12">
            <TextBlock Classes="h2" Text="{Binding #CompactCategory.((ComboBoxItem)SelectedItem).Content}" />
          </Border>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnSettingsScrolled" SizeChanged="OnScrollSizeChanged">
          <StackPanel x:Name="SettingsSections" Classes="page" Margin="0">

      <v:AppearanceSettingsView x:Name="AppearanceSection" />

      <Border x:Name="ImportSection" Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{l:T settings.section.import}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:T settings.clipboard}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0" />
            <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{l:T settings.clipboard}" IsChecked="{Binding SuggestClipboardLinks}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="{l:T subs.auto}" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{l:T subs.auto.hint}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{l:T subs.auto}" IsChecked="{Binding SubscriptionAutoUpdate}" />
          </Grid>
          <StackPanel Spacing="6" IsVisible="{Binding SubscriptionAutoUpdate}">
            <TextBlock Text="{l:T subs.interval}" />
            <NumericUpDown Value="{Binding SubscriptionUpdateIntervalHours}" Minimum="1" Maximum="168" FormatString="0" Width="140" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="DesktopSection" Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{l:T settings.desktop}" />
          <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding AutostartSupported}">
            <TextBlock Text="{l:T settings.desktop.autostart}" TextWrapping="Wrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{l:T settings.desktop.autostart}" IsChecked="{Binding StartWithSystem}" />
          </Grid>
          <TextBlock Classes="faint" Text="{l:T settings.desktop.autostart.hint}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:T settings.desktop.connect}" TextWrapping="Wrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{l:T settings.desktop.connect}" IsChecked="{Binding ConnectOnStartup}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:T settings.desktop.tray}" TextWrapping="Wrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{l:T settings.desktop.tray}" IsChecked="{Binding MinimizeToTray}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:T settings.desktop.notifications}" TextWrapping="Wrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{l:T settings.desktop.notifications}" IsChecked="{Binding ShowNotifications}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Connection -->
      <Border x:Name="ConnectionSection" Classes="panel">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="{l:T settings.connection}" />
          <TextBlock Classes="faint" Text="{l:T settings.admin.hint}" TextWrapping="Wrap" />
          <Button Classes="ghost" HorizontalAlignment="Left" Content="{l:T settings.admin.restart}" Command="{Binding RestartElevatedCommand}" IsVisible="{Binding CanRestartElevated}" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="{l:T settings.autoreconnect}" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{l:T settings.autoreconnect.hint}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{l:T settings.autoreconnect}" IsChecked="{Binding AutoReconnect}" />
          </Grid>
          <Button Classes="ghost" Content="{l:T settings.killswitch.disable}" Command="{Binding DisableKillSwitchCommand}" IsVisible="{Binding KillSwitch}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <v:AdvancedSettingsView x:Name="AdvancedSection" />

      <!-- Backup -->
      <Expander x:Name="BackupSettings" Header="{l:T backup.title}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12" IsEnabled="{Binding !BackupBusy}">
          <TextBlock Classes="h2" Text="{l:T backup.title}" />
          <TextBlock Classes="faint" Text="{l:T backup.hint}" TextWrapping="Wrap" />
          <TextBox Text="{Binding BackupPassword}" PasswordChar="●" Watermark="{l:T backup.password}" />
          <TextBox Text="{Binding BackupPasswordConfirmation}" PasswordChar="●" Watermark="{l:T backup.password.confirm}" />
          <WrapPanel>
            <Button Classes="ghost" Content="{l:T backup.export}" Command="{Binding ExportBackupCommand}" Margin="0,0,8,8" />
            <Button Classes="ghost" Content="{l:T backup.import}" Command="{Binding OpenBackupCommand}" Margin="0,0,0,8" />
          </WrapPanel>
          <StackPanel IsVisible="{Binding HasBackupPreview}" Spacing="12">
            <TextBlock Classes="h3" Text="{l:T backup.preview}" />
            <ToggleSwitch IsChecked="{Binding BackupReplace}">
              <TextBlock Text="{l:T backup.replace}" TextWrapping="Wrap" />
            </ToggleSwitch>
            <ScrollViewer MaxHeight="300">
              <TextBlock Text="{Binding BackupPreviewText}" TextWrapping="Wrap" />
            </ScrollViewer>
            <WrapPanel>
              <Button Content="{l:T backup.apply}" Command="{Binding ApplyBackupCommand}" Margin="0,0,8,8" />
              <Button Classes="ghost" Content="{l:T backup.cancel}" Command="{Binding CancelBackupCommand}" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </Expander>

      <!-- About & credits -->
      <Expander x:Name="AboutSection" Header="{l:T settings.about}" HorizontalAlignment="Stretch" SizeChanged="OnScrollSizeChanged">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Image Source="{StaticResource BrandLogo}" Width="38" Height="38" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Version, StringFormat='BYDLO {0}'}" FontWeight="Bold" />
              <TextBlock Classes="faint" Text="{l:T app.full}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="muted" Text="{l:T about.text}" TextWrapping="Wrap" />
          <Border Classes="tile">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Margin="0,0,18,0">
                  <TextBlock Text="{l:T settings.update.auto}" FontWeight="Medium" TextWrapping="Wrap" />
                  <TextBlock Classes="faint" Text="{l:T settings.update.auto.hint}" TextWrapping="Wrap" IsVisible="{Binding IsAutoUpdateAvailable}" />
                  <TextBlock Classes="faint" Text="{l:T settings.update.auto.unavailable}" TextWrapping="Wrap" IsVisible="{Binding !IsAutoUpdateAvailable}" />
                </StackPanel>
                <ToggleSwitch x:Name="AutoUpdateToggle" Grid.Column="1" AutomationProperties.Name="{l:T settings.update.auto}"
                              IsChecked="{Binding AutoUpdateApp}" IsEnabled="{Binding IsAutoUpdateAvailable}" />
              </Grid>
              <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{Binding UpdateDetail}" TextWrapping="Wrap" />
              <ProgressBar IsVisible="{Binding IsDownloadingUpdate}" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" />
              <WrapPanel>
                <Button Classes="ghost" Content="{l:T settings.update.check}" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0" IsEnabled="{Binding !IsCheckingUpdates}" />
                <Button Classes="primary" Content="{l:T settings.update.download}" Command="{Binding DownloadUpdateCommand}" Margin="0,0,8,0" IsEnabled="{Binding CanDownloadUpdate}" />
                <Button Classes="ghost" Content="{l:T settings.update.open}" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding UpdateUrl}" IsVisible="{Binding HasUpdateUrl}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Button x:Name="ContributorsButton" Classes="ghost" HorizontalAlignment="Left" Content="{l:T nav.contributors}"
                  Command="{Binding Shell.NavigateCommand}" CommandParameter="contributors" />
          <Border Classes="tile">
            <StackPanel Spacing="8">
              <TextBlock Text="{l:T report.hint}" Classes="faint" TextWrapping="Wrap" />
              <WrapPanel>
                <Button Classes="ghost" Content="{l:T report.copy}" Command="{Binding CopyDiagnosticReportCommand}" Margin="0,0,8,0" />
                <Button Classes="ghost" Content="{l:T report.open}" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding BugTemplateUrl}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="caps" Text="{l:T about.credits}" Margin="0,6,0,0" />
          <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.Credits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:Credit">
                <Border Classes="tile" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="1">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                        <TextBlock Classes="faint" Text="{Binding Author}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Classes="faint" Text="{Binding LocalizedRole}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Classes="pill"><TextBlock Text="{Binding License}" /></Border>
                      <Button Classes="icon" ToolTip.Tip="{Binding Url}"
                              Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding Url}">
                        <c:OutlineIcon Data="{StaticResource LineLink}" Width="15" Height="15" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
            <Border x:Name="ScrollTail" IsHitTestVisible="False" />
          </StackPanel>
        </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
