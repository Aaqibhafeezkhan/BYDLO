<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Bydlo.App.Controls"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:st="using:Bydlo.Core.Storage"
             xmlns:l="using:Bydlo.App.Services"
             x:Class="Bydlo.App.Views.ConnectionsView"
             x:DataType="vm:ConnectionsViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="880" Margin="24,32,24,32" Spacing="24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="{l:T nav.connections}" />
        <TextBlock Classes="muted" Text="{l:T connections.subtitle}" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Import -->
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="h3" Text="{l:T import.title}" />
          <WrapPanel>
            <Button Classes="primary" Margin="0,0,8,8" Command="{Binding PasteFromClipboardCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:OutlineIcon Data="{StaticResource LinePaste}" Width="16" Height="16" Foreground="{DynamicResource OnPrimaryBrush}" />
                <TextBlock Text="{l:T import.clipboard}" Foreground="{DynamicResource OnPrimaryBrush}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Margin="0,0,8,8" Command="{Binding ImportFromFileCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:OutlineIcon Data="{StaticResource LineFile}" Width="16" Height="16" />
                <TextBlock Text="{l:T import.file}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Margin="0,0,8,8" Command="{Binding ImportFromQrImageCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:OutlineIcon Data="{StaticResource LineQr}" Width="16" Height="16" />
                <TextBlock Text="{l:T import.qr}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Margin="0,0,8,8" Command="{Binding AddDemoProfilesCommand}" IsVisible="{Binding Shell.IsMock}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:OutlineIcon Data="{StaticResource LineFlask}" Width="16" Height="16" />
                <TextBlock Text="{l:T import.demo}" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <Expander Header="{l:T import.manual}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="12">
          <TextBox Text="{Binding ImportText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160"
                   Watermark="{l:T import.placeholder}" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" />
          <Button Classes="ghost" HorizontalAlignment="Right" Content="{l:T import.add}" Command="{Binding ImportFromTextCommand}" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>

      <!-- Profiles -->
      <StackPanel Spacing="10">
        <TextBlock Classes="caps" Text="{l:T connections.profiles}" />
        <Border Classes="card" IsVisible="{Binding IsEmpty}">
          <StackPanel Spacing="6" HorizontalAlignment="Center">
            <c:OutlineIcon Data="{StaticResource LineServers}" Width="34" Height="34" Foreground="{DynamicResource TextFaintBrush}" />
            <TextBlock Classes="muted" Text="{l:T connections.empty}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="panel" Padding="18,0" IsVisible="{Binding !IsEmpty}">
        <ItemsControl ItemsSource="{Binding Shell.Profiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileItem">
              <Border Classes="row profile-row" Classes.active="{Binding IsActive}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Surface2Brush}">
                    <c:OutlineIcon Data="{StaticResource LineShield}" Foreground="{DynamicResource AccentBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <Border Classes="pill ok" HorizontalAlignment="Left" Padding="7,1" IsVisible="{Binding IsActive}">
                        <TextBlock Text="{l:T status.connected}" FontSize="10" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="faint" Text="{Binding Details}" />
                    <TextBlock Classes="faint" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="icon" Content="⋯" AutomationProperties.Name="{l:T share.title}" ToolTip.Tip="{l:T share.title}">
                      <Button.Flyout>
                        <Flyout>
                          <StackPanel Spacing="6">
                            <Button Content="{l:T share.qr}" IsVisible="{Binding CanShareLink}"
                                    Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).ShowQrCommand}" CommandParameter="{Binding}" />
                            <Button Content="{l:T share.copy}" IsVisible="{Binding CanShareLink}"
                                    Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).CopyLinkCommand}" CommandParameter="{Binding}" />
                            <Button Content="{l:T share.file}" IsVisible="{Binding CanExportConfig}"
                                    Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).ExportConfigCommand}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Classes="icon" AutomationProperties.Name="{l:T connections.favorite}" ToolTip.Tip="{l:T connections.favorite}"
                            Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).ToggleFavoriteCommand}" CommandParameter="{Binding}">
                      <Panel>
                        <c:OutlineIcon Data="{StaticResource LineStar}" Width="16" Height="16" IsVisible="{Binding IsFavorite}" Foreground="{DynamicResource WarningBrush}" />
                        <c:OutlineIcon Data="{StaticResource LineStar}" Width="16" Height="16" IsVisible="{Binding !IsFavorite}" Opacity="0.4" />
                      </Panel>
                    </Button>
                    <Button Classes="icon" AutomationProperties.Name="{l:T connections.delete}" ToolTip.Tip="{l:T connections.delete}"
                            Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}">
                      <c:OutlineIcon Data="{StaticResource LineDelete}" Width="16" Height="16" />
                    </Button>
                    <Button AutomationProperties.Name="{l:T home.connect}" Classes="ghost" Margin="6,0,0,0" Padding="10,8"
                            Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).ConnectToCommand}" CommandParameter="{Binding}">
                      <c:OutlineIcon Data="{StaticResource LinePower}" Width="16" Height="16" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Border>
      </StackPanel>

      <!-- Subscriptions -->
      <Expander Header="{l:T subs.title}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12">
          <TextBlock Classes="faint" Text="{l:T subs.hint}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBox Text="{Binding SubscriptionUrl}" Watermark="https://…" />
            <TextBox Grid.Row="1" Margin="0,8,0,0" Text="{Binding SubscriptionName}" Watermark="{l:T subs.name}" />
            <Button Grid.Column="1" Grid.RowSpan="2" Margin="8,0,0,0" Classes="primary" VerticalAlignment="Stretch"
                    Content="{l:T subs.add}" Command="{Binding AddSubscriptionCommand}" IsEnabled="{Binding !IsWorking}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Subscriptions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="st:Subscription">
                <Border Classes="tile" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                      <TextBlock Classes="faint" Text="{Binding LastUpdated, StringFormat='{}{0:g}'}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T subs.refresh}"
                            Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).RefreshSubscriptionCommand}" CommandParameter="{Binding}">
                      <c:OutlineIcon Data="{StaticResource LineRefresh}" Width="16" Height="16" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
