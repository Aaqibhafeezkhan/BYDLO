<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:v="using:Bydlo.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Bydlo.App.Controls"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:m="using:Bydlo.Core.Models"
             xmlns:l="using:Bydlo.App.Services"
             x:Class="Bydlo.App.Views.AdvancedSettingsView"
             x:DataType="vm:SettingsViewModel">
  <Expander x:Name="AdvancedSettings" Header="{l:T common.advanced}" IsExpanded="{Binding ShowAdvanced, Mode=TwoWay}" HorizontalAlignment="Stretch">
    <StackPanel Spacing="14">
      <v:ActiveConnectionsView DataContext="{Binding Shell.ActiveConnections}" />
      <TextBlock Classes="faint" Text="{l:T settings.associations.hint}" TextWrapping="Wrap" />
      <WrapPanel IsEnabled="{Binding CanRegisterAssociations}">
        <Button Classes="ghost" Content="{l:T settings.associations.register}" Command="{Binding RegisterAssociationsCommand}" Margin="0,0,8,8" />
        <Button Classes="ghost" Content="{l:T settings.associations.remove}" Command="{Binding RemoveAssociationsCommand}" Margin="0,0,0,8" />
      </WrapPanel>
      <StackPanel Spacing="8">
        <StackPanel>
          <TextBlock Text="{l:T settings.check.service}" FontWeight="Medium" />
          <TextBlock Classes="faint" Text="{l:T settings.check.service.hint}" TextWrapping="Wrap" />
        </StackPanel>
        <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.CheckProviders}" SelectedItem="{Binding IpCheckProvider}" MinWidth="180" HorizontalAlignment="Left">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:IpCheckProvider">
              <TextBlock Text="{Binding Converter={x:Static l:PrefixLocConverter.Instance}, ConverterParameter=check.provider.}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <Border Classes="tile">
        <StackPanel Spacing="10">
          <TextBlock Text="{l:T settings.killswitch}" FontWeight="SemiBold" />
          <TextBlock Text="{l:T settings.killswitch.warning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{l:T settings.killswitch.active}" IsVisible="{Binding KillSwitch}" TextWrapping="Wrap" />
          <StackPanel IsVisible="{Binding !KillSwitch}" Spacing="8">
            <CheckBox IsChecked="{Binding KillSwitchAcknowledged}" Content="{l:T settings.killswitch.ack}" />
            <Button Classes="ghost" Content="{l:T settings.killswitch.enable}" Command="{Binding EnableKillSwitchCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Margin="0,0,18,0">
          <TextBlock Text="{l:T settings.port}" FontWeight="Medium" TextWrapping="Wrap" />
          <TextBlock Classes="faint" Text="{l:T settings.port.hint}" TextWrapping="Wrap" />
        </StackPanel>
        <NumericUpDown Grid.Column="1" Value="{Binding LocalPort}" Minimum="1024" Maximum="65535" FormatString="0" Width="140" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Margin="0,0,18,0">
          <TextBlock Text="{l:T settings.sysproxy}" FontWeight="Medium" TextWrapping="Wrap" />
          <TextBlock Classes="faint" Text="{l:T settings.sysproxy.hint}" TextWrapping="Wrap" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SetSystemProxy}" IsEnabled="{Binding SystemProxySupported}" />
      </Grid>

      <Border Classes="tile">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="{l:T settings.lan}" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{l:T settings.lan.hint}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowLan}" />
          </Grid>
          <StackPanel Spacing="8" IsVisible="{Binding AllowLan}">
            <TextBlock Text="{l:T settings.lan.warning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
            <TextBlock Classes="caps" Text="{l:T settings.lan.login}" />
            <TextBox Text="{Binding LocalProxyUsername}" Watermark="{l:T settings.lan.login}" MaxLength="64" />
            <TextBlock Classes="caps" Text="{l:T settings.lan.password}" />
            <TextBox Text="{Binding LocalProxyPassword}" PasswordChar="●" Watermark="{l:T settings.lan.password}" MaxLength="128" />
            <TextBlock Classes="faint" Text="{l:T settings.lan.saved}" IsVisible="{Binding HasLocalProxyPassword}" TextWrapping="Wrap" />
            <TextBlock Classes="faint" Text="{l:T settings.lan.nopassword}" IsVisible="{Binding !HasLocalProxyPassword}" TextWrapping="Wrap" />
            <TextBlock Classes="faint" Text="{l:T settings.lan.firewall}" TextWrapping="Wrap" />
            <TextBlock Text="{l:T settings.lan.sysproxy}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding LanSysProxyConflict}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="tile">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:OutlineIcon Data="{StaticResource LineFlask}" Foreground="{DynamicResource WarningBrush}" />
            <TextBlock Text="{l:T settings.mock}" FontWeight="Medium" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Classes="faint" Text="{l:T settings.mock.hint}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:T settings.mock.enable}" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding MockMode}" IsEnabled="{Binding !MockForcedByFlag}" />
          </Grid>
          <TextBlock Classes="faint" Text="{l:T settings.mock.forced}" IsVisible="{Binding MockForcedByFlag}" />
          <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Scenarios}" SelectedItem="{Binding MockScenario}" MinWidth="220">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="m:MockScenario">
                <TextBlock Text="{Binding Converter={x:Static l:PrefixLocConverter.Instance}, ConverterParameter=mock.}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Classes="tile">
        <StackPanel Spacing="6">
          <TextBlock Text="{l:T settings.system}" FontWeight="Medium" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="muted" Text="{l:T settings.admin}" />
            <TextBlock Text="{l:T common.yes}" IsVisible="{Binding IsElevated}" />
            <TextBlock Text="{l:T common.no}" IsVisible="{Binding !IsElevated}" />
          </StackPanel>
          <TextBlock Classes="faint" Text="{l:T settings.admin.hint}" TextWrapping="Wrap" />
          <TextBlock Classes="faint" Text="{l:T settings.admin.manual}" TextWrapping="Wrap" IsVisible="{Binding ShowElevationManualHint}" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanRestartElevated}">
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="{l:T settings.admin.autorestart}" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{l:T settings.admin.autorestart.hint}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunElevatedOnStartup}" />
          </Grid>
          <TextBlock Text="{l:T helper.title}" FontWeight="Medium" />
          <TextBlock Classes="faint" Text="{l:T helper.hint}" TextWrapping="Wrap" />
          <TextBlock Classes="faint" Text="{l:T helper.unsupported}" IsVisible="{Binding !HelperSupported}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HelperSupported}" IsEnabled="{Binding CanManageHelper}">
            <Button Content="{l:T helper.install}" Command="{Binding InstallHelperCommand}" IsVisible="{Binding !HelperInstalled}" />
            <Button Classes="ghost" Content="{l:T helper.remove}" Command="{Binding RemoveHelperCommand}" IsVisible="{Binding HelperInstalled}" />
          </StackPanel>
          <TextBlock Text="{Binding HelperStatus}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="muted" Text="{l:T settings.secrets}" />
            <TextBlock Text="{Binding SecretProtection}" TextWrapping="Wrap" />
          </StackPanel>
          <SelectableTextBlock Classes="mono" Text="{Binding DataDirectory}" TextWrapping="Wrap" />
          <TextBlock Classes="faint" Foreground="{DynamicResource WarningBrush}" Text="{l:T settings.safelock}" IsVisible="{Binding SafetyLock}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Expander>
</UserControl>
