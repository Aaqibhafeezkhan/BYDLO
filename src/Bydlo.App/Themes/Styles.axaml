<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Bydlo.App.Controls">

  <Style Selector="StackPanel.page">
    <Setter Property="MaxWidth" Value="1040" />
    <Setter Property="Margin" Value="20,24,20,28" />
    <Setter Property="Spacing" Value="20" />
  </Style>
  <Style Selector="Border.page-heading">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,0,0,14" />
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Border.connection-workspace">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="22" />
  </Style>

  <Style Selector="Border.session-strip">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.session-strip.connected">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.session-strip.busy">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.session-strip.error">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="StackPanel.profile-actions">
    <Setter Property="Grid.Column" Value="2" />
  </Style>
  <Style Selector="Grid.reflow > StackPanel.profile-actions">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="8,8,0,0" />
  </Style>
  <Style Selector="Border.readout">
    <Setter Property="Padding" Value="0,12,0,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.caps">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Cards -->
  <Style Selector="Button.source-card">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.pill.ok">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>
  <Style Selector="Border.pill.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.pill.warn">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>
  <Style Selector="Border.pill.warn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.pill.bad">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>
  <Style Selector="Border.pill.bad TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Border.pill Ellipse.dot">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.pill.ok Ellipse.dot">
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.pill.warn Ellipse.dot">
    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.pill.bad Ellipse.dot">
    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>
  <Style Selector="Border.banner.bad">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>

  <!-- Icons -->
  <Style Selector="c|OutlineIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Navigation -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Name="bg" CornerRadius="8" Padding="14,11" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
          <Border Name="marker" Width="2" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="1" Background="Transparent" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
  </Style>
  <Style Selector="RadioButton.nav:focus-visible /template/ Border#bg">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
  </Style>
  <Style Selector="RadioButton.nav TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="RadioButton.nav c|OutlineIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked c|OutlineIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="RadioButton.navbottom /template/ Border#bg">
    <Setter Property="Padding" Value="2,7" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Segmented choice (theme, mode) -->
  <Style Selector="RadioButton.segment">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" CornerRadius="8" Padding="12,9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#bg">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:focus-visible /template/ Border#bg">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="RadioButton.segment TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="RadioButton.segment:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="KnobTransitions" Value="{x:Null}" />
  </Style>
  <Style Selector=".motion ToggleSwitch">
    <Setter Property="KnobTransitions">
      <Transitions><DoubleTransition Property="Canvas.Left" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>

  <!-- List items -->
  <Style Selector="ListBox.cards">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
  </Style>


  <Style Selector="UserControl"><Setter Property="FontSize" Value="14" /></Style>
  <Style Selector="Border.section">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,24,0,0" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,16" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
  </Style>
  <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.60" /></Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="RadioButton.segment:pointerover /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="TextBlock.page-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="tnum" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="22" />
  </Style>
  <Style Selector="Border.connection-mark">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.connection-mark c|OutlineIcon"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>
  <Style Selector="Border.connection-mark.connected c|OutlineIcon"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></Style>
  <Style Selector="Border.connection-mark.busy c|OutlineIcon"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.connection-mark.error c|OutlineIcon"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Border.mode-switch">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="RadioButton.mode /template/ Border#bg"><Setter Property="Padding" Value="12,6" /><Setter Property="CornerRadius" Value="5" /></Style>
  <Style Selector="RadioButton.mode:checked /template/ Border#bg"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Style>
  <Style Selector="RadioButton.mode TextBlock"><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#marker"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="RadioButton.navbottom /template/ Border#marker"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="RadioButton.navbottom:checked /template/ Border#bg"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="RadioButton.navbottom:checked TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="ComboBox.server-picker">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MinHeight" Value="52" />
  </Style>
  <Style Selector="Button.connect-action"><Setter Property="CornerRadius" Value="7" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="Button.text-action">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="0,4" />
  </Style>
  <Style Selector="Button.text-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.profile-row.active">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Expander"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="FontSize" Value="13" /></Style>

  <!-- Simple disclosure rows, including a deterministic vector chevron. -->
  <Style Selector="ToggleButton.disclosure">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="header" Padding="0,13" BorderThickness="0,0,0,1" BorderBrush="Transparent" CornerRadius="6">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <c:OutlineIcon Name="chevron" Grid.Column="1" Width="14" Height="14" Data="{StaticResource LineChevron}" RenderTransformOrigin="50%,50%" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.disclosure:checked /template/ c|OutlineIcon#chevron"><Setter Property="RenderTransform" Value="rotate(90deg)" /></Style>
  <Style Selector="ToggleButton.disclosure:pointerover /template/ Border#header"><Setter Property="Background" Value="{DynamicResource Surface2Brush}" /></Style>
  <Style Selector="ToggleButton.disclosure:focus-visible /template/ Border#header"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Expander">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,Auto">
          <ToggleButton Classes="disclosure" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
          <Border Grid.Row="1" IsVisible="{TemplateBinding IsExpanded}" Padding="0,12,0,8">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton:disabled"><Setter Property="Opacity" Value="0.60" /></Style>
  <Style Selector=".desktop Border.workspace">
    <Setter Property="MaxWidth" Value="1080" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector=".desktop Border.workspace > StackPanel.page">
    <Setter Property="Margin" Value="32,28,32,32" />
    <Setter Property="Spacing" Value="18" />
  </Style>
  <Style Selector=".desktop Border.workspace TextBlock.h1">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>
  <Style Selector=".desktop Border.workspace Border.page-heading">
    <Setter Property="Padding" Value="0,0,0,18" />
  </Style>
  <Style Selector=".desktop Border.workspace Border.settings-heading">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.utility-list">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector=".desktop Border.connection-workspace">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector=".desktop Border.session-strip">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="18,16" />
  </Style>
  <Style Selector=".desktop Button.connect-action">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MinWidth" Value="186" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Fill" Value="{DynamicResource OnPrimaryBrush}" />
  </Style>
  <Style Selector=".desktop WrapPanel.empty-actions">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
</Styles>
