<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared vector master for the shell, executable, window and tray icons. -->
  <SolidColorBrush x:Key="BrandTileBrush" Color="#202020" />
  <SolidColorBrush x:Key="BrandInkBrush" Color="#FFFFFF" />
  <DrawingImage x:Key="BrandLogo">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource BrandTileBrush}"
                         Geometry="M11 1H53Q63 1 63 11V53Q63 63 53 63H11Q1 63 1 53V11Q1 1 11 1Z" />
        <GeometryDrawing Brush="{StaticResource BrandInkBrush}"
                         Geometry="F0 M16 11H37L46 20V26L41 31L48 38V45L40 53H16Z M25 19V28H34L38 24L34 19Z M25 36V45H36L40 41L36 36Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
