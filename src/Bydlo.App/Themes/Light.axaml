<!-- BYDLO light theme: white surfaces with the same violet accent. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="AccentColor">#7C4DDB</Color>
  <Color x:Key="PrimaryColor">#7C4DDB</Color>

  <SolidColorBrush x:Key="BgBrush" Color="#F6F3FC" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#BBFFFFFF" />
  <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0%,0%" EndPoint="65%,100%">
    <GradientStop Offset="0" Color="#EFFFFFFF" />
    <GradientStop Offset="0.35" Color="#A6FFFFFF" />
    <GradientStop Offset="1" Color="#B0F5EFFD" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Surface2Brush" Color="#70E8DFF6" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#B0E9DEF9" />
  <SolidColorBrush x:Key="LineBrush" Color="#55A18ABA" />
  <SolidColorBrush x:Key="AccentBrush" Color="#7444CA" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="#7C4DDB" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F7C4DDB" />
  <SolidColorBrush x:Key="TextBrush" Color="#1B1428" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#625473" />
  <SolidColorBrush x:Key="TextFaintBrush" Color="#796A8D" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#15994A" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F15994A" />
  <SolidColorBrush x:Key="WarningBrush" Color="#B7791F" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#1FB7791F" />
  <SolidColorBrush x:Key="DangerBrush" Color="#D63B3B" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FD63B3B" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />

  <LinearGradientBrush x:Key="BackdropBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#F8F4FF" />
    <GradientStop Offset="0.5" Color="#EEE5F8" />
    <GradientStop Offset="1" Color="#E4DCF3" />
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="GlowBrush" GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
    <GradientStop Offset="0" Color="#447C4DDB" />
    <GradientStop Offset="1" Color="#007C4DDB" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="GlowOnBrush" GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
    <GradientStop Offset="0" Color="#4415994A" />
    <GradientStop Offset="1" Color="#0015994A" />
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="ConnectIdleBrush" StartPoint="10%,0%" EndPoint="85%,100%">
    <GradientStop Offset="0" Color="#EFFFFFFF" />
    <GradientStop Offset="1" Color="#BBDCD0F0" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ConnectOnBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#9B72EA" />
    <GradientStop Offset="1" Color="#6A3BCB" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#9B72EA" />
    <GradientStop Offset="1" Color="#6A3BCB" />
  </LinearGradientBrush>

  <!-- Fluent control overrides -->
  <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#F0EBFA" />
  <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#E8E0F8" />
  <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#E8E0F8" />
  <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
  <SolidColorBrush x:Key="ExpanderContentBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#E3DCF0" />

  <!-- Layered glass: directional edge light, translucent fill and soft elevation. -->
  <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0%,0%" EndPoint="80%,100%">
    <GradientStop Offset="0" Color="#FFFFFFFF" />
    <GradientStop Offset="0.45" Color="#48C8B0ED" />
    <GradientStop Offset="1" Color="#55A18ABA" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0%,0%" EndPoint="35%,100%">
    <GradientStop Offset="0" Color="#12FFFFFF" />
    <GradientStop Offset="1" Color="#00FFFFFF" />
  </LinearGradientBrush>
  <BoxShadows x:Key="GlassShadow">0 12 36 0 #120E0528</BoxShadows>
  <BoxShadows x:Key="ConnectShadow">0 16 48 0 #120E0528</BoxShadows>
</ResourceDictionary>
