<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Bydlo.App.Themes.LightPalette">
  <Color x:Key="AccentColor">#222222</Color>
  <Color x:Key="PrimaryColor">#191919</Color>
  <SolidColorBrush x:Key="BgBrush" Color="#F5F5F5" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#EDEDED" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Surface2Brush" Color="#F1F1F1" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E8E8E8" />
  <SolidColorBrush x:Key="LineBrush" Color="#D8D8D8" />
  <SolidColorBrush x:Key="AccentBrush" Color="#222222" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="#191919" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4E4E4" />
  <SolidColorBrush x:Key="TextBrush" Color="#171717" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#4C4C4C" />
  <SolidColorBrush x:Key="TextFaintBrush" Color="#606060" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#242424" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EBEBEB" />
  <SolidColorBrush x:Key="WarningBrush" Color="#444444" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#EFEFEF" />
  <SolidColorBrush x:Key="DangerBrush" Color="#262626" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#EAEAEA" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BackdropBrush" Color="#F5F5F5" />
  <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
  <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#E8E8E8" />
  <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#F1F1F1" />
  <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
  <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#353535" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#080808" />
  <SolidColorBrush x:Key="ButtonEdgeBrush" Color="#303030" />
  <SolidColorBrush x:Key="NavActiveBrush" Color="#DEDEDE" />
  <SolidColorBrush x:Key="EdgeBrush" Color="#929292" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
</ResourceDictionary>
