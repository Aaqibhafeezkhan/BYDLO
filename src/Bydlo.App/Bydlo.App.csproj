<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Bydlo.App</RootNamespace>
    <AssemblyName>Bydlo.App</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The desktop app ships trimmed; see docs/BUILD.md. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <InternalsVisibleTo Include="Bydlo.Screenshots" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bydlo.Core\Bydlo.Core.csproj" />
    <ProjectReference Include="..\Bydlo.Engines\Bydlo.Engines.csproj" />
    <ProjectReference Include="..\Bydlo.Platform\Bydlo.Platform.csproj" />
  </ItemGroup>
</Project>
