<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Shipped trimmed (app) and Native AOT (helper); see docs/BUILD.md. -->
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Bydlo.Engines</RootNamespace>
    <AssemblyName>Bydlo.Engines</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <Protobuf Include="Groups/Protos/*.proto" GrpcServices="Client" />
    <ProjectReference Include="..\Bydlo.Core\Bydlo.Core.csproj" />
    <ProjectReference Include="..\Bydlo.Platform\Bydlo.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\engines\engines.lock.json" LogicalName="engines.lock.json" />
    <EmbeddedResource Include="..\..\engines\bydlo-zapret-list.txt" LogicalName="bydlo-zapret-list.txt" />
    <InternalsVisibleTo Include="Bydlo.Tests" />
  </ItemGroup>
</Project>
