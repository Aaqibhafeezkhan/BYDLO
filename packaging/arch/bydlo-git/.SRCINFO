pkgbase = bydlo-git
	pkgdesc = Bypass Your Digital Limitations Online — one app for every protocol
	pkgver = 0.4.0
	pkgrel = 1
	url = https://github.com/endercodezz/BYDLO
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = dotnet-sdk
	makedepends = go
	makedepends = jq
	depends = glibc
	depends = gcc-libs
	depends = zlib
	depends = icu
	depends = openssl
	depends = fontconfig
	depends = freetype2
	depends = libx11
	depends = libice
	depends = libsm
	depends = libxcursor
	depends = libxext
	depends = libxi
	depends = libxrandr
	optdepends = libsecret: store profile secrets in the Secret Service keyring
	optdepends = libnotify: desktop notifications
	optdepends = openvpn: OpenVPN profiles
	optdepends = wireguard-tools: WireGuard profiles
	provides = bydlo
	conflicts = bydlo
	conflicts = bydlo-bin
	options = !strip
	options = !debug
	source = BYDLO::git+https://github.com/endercodezz/BYDLO.git
	sha256sums = SKIP

pkgname = bydlo-git
